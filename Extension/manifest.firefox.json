{
  "manifest_version": 3,
  "name": "Presence",
  "version": "0.1.0",
  "description": "Notices when you keep opening the same site and asks: is this what you need to be doing?",
  "browser_specific_settings": {
    "gecko": {
      "id": "presence@thatgibbyguy",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "webNavigation",
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Presence",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["src/block/block.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
